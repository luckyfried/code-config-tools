  "_notes": {
    "csvFile": "The bank's CSV export, as a path relative to this inputs file. sample/checking-export.csv is the six-month sample that ships with the app.",
    "columns": "The export's column names: date, description, and amount; category when the export has one (Mint, YNAB, and Monarch do); debit and credit instead of amount when amountSign is debit-credit-columns.",
    "dateFormat": "A strptime pattern for the date column: %m/%d/%Y for 09/18/2026, %Y-%m-%d for 2026-09-18, %d.%m.%Y for 18.09.2026.",
    "amountSign": "negative-is-spend (most banks), positive-is-spend (most card exports), or debit-credit-columns (money out and money in in two columns).",
    "currency": "The currency the amounts are in, as a three-letter code: USD, EUR, GBP, CAD.",
    "rules": "Checked in order against each description, ignoring case; the first whose match appears in it wins. category is a category id, income, or ignore (a transfer between the person's own accounts). merchant is the name shown for it; without one the page cleans up the description.",
    "categories": "Four to eight, in the person's own words: id (lowercase, used by rules), label, and a hex color. Spending no rule matches is shown as Other.",
    "months": "How many months back from the newest month in the export the page covers.",
    "showMerchants": "true names merchants and payers on the page; false shows each category's merchants as one group, for a page hosted in public.",
    "theme": "auto follows the device's light or dark setting; ledger is paper white; vault is near black."
  }
}
