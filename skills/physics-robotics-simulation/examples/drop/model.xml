<mujoco model="drop">
  <!-- SI units throughout: meters, kilograms, seconds, radians. +Z is up. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81">
    <flag energy="enable"/>
  </option>
  <worldbody>
    <light pos="0 -1.5 2.5" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" friction="0.8 0.005 0.0001" rgba="0.85 0.85 0.85 1"/>
    <body name="box" pos="0 0 0.5">
      <freejoint name="box_free"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.000833333 0.000833333 0.000833333"/>
      <geom name="box_col" type="box" size="0.05 0.05 0.05" rgba="0.9 0.3 0.2 1"/>
      <site name="box_center"/>
    </body>
  </worldbody>
  <sensor>
    <framepos name="box_pos" objtype="site" objname="box_center"/>
    <framelinvel name="box_vel" objtype="site" objname="box_center"/>
  </sensor>
  <keyframe>
    <key name="start" qpos="0 0 0.5 1 0 0 0"/>
  </keyframe>
</mujoco>
