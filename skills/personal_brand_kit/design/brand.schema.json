{
  "title": "brand.json: one person's brand system",
  "type": "object",
  "required": [
    "handle",
    "statement",
    "palette",
    "pillars",
    "cadence",
    "voice",
    "aspire",
    "stop",
    "first_week"
  ],
  "properties": {
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 8,
      "maxLength": 140
    },
    "source": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "hex",
          "role",
          "share"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "role": {
            "enum": [
              "lead",
              "ground",
              "ink",
              "accent",
              "support"
            ]
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "posts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "compositions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pillars": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "share",
          "example"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "example": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "cadence": {
      "type": "object",
      "required": [
        "per_week",
        "slots",
        "timezone"
      ],
      "properties": {
        "per_week": {
          "type": "number",
          "minimum": 0
        },
        "timezone": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "day",
              "time"
            ],
            "properties": {
              "day": {
                "enum": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday",
                  "Sunday"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "case",
        "devices"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "avg_words": {
          "type": "number"
        },
        "emoji_per_caption": {
          "type": "number"
        },
        "devices": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "name",
              "share",
              "examples"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          }
        },
        "lean_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "aspire": {
      "type": "object",
      "required": [
        "palette",
        "subjects",
        "line"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "hex"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "stop": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "line",
          "why"
        ],
        "properties": {
          "line": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "first_week": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "date",
          "kind",
          "pillar",
          "caption"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "post",
              "story"
            ]
          },
          "pillar": {
            "type": "string"
          },
          "caption": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
