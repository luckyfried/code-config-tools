      "tracking": 0,
      "case": "none",
      "lineHeight": 1.0
    },
    "text": {
      "family": "Gloock",
      "file": "fonts/styles/scrapbook/Gloock-Regular.ttf",
      "weight": 400,
      "tracking": 0,
      "case": "none",
      "lineHeight": 1.15
    }
  },
  "palette": {
